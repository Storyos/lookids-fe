generator client {
  provider = "prisma-client-js"
  output   = "../generated/mongo-client" // 별도의 클라이언트 생성
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_DATABASE_URL")
}

model Post {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  content   String?
  createdAt DateTime @default(now())
}
